# --- MongoDB (no secrets for default local mongod) ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=phonic_kids_db

# --- OpenAI TTS: set your key locally (never commit real keys) ---
OPENAI_API_KEY=

# --- JWT: local-only placeholder (replace with a long random string for production) ---
JWT_SECRET=local-development-only-not-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
